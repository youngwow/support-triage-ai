# Copy to .env. Both are optional — without them the service still starts and
# runs in its degraded mode, which is a supported way to demo the PoC.

# Gemini API key. Without it classification falls back to the rule classifier
# and no drafts are generated.
GEMINI_API_KEY=

# Hugging Face token. Only needed if ai-sage/Giga-Embeddings-instruct requires
# authentication for your account; retrieval is skipped without the model.
HF_TOKEN=
